# docker compose reads this file after copying it to .env (never commit secrets).
BETTER_AUTH_URL=https://pokesurvivor.duenas.dev.br
BETTER_AUTH_SECRET=

# Required for registration, recovery and deletion confirmation.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Google OAuth client. Redirect URI: BETTER_AUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Exact ingress peer IPs only, comma separated; empty = use socket address.
AUTH_TRUSTED_PROXIES=
ADMINS=
REDE_DA_BORDA=pokesurvivor-borda
REDE_DA_BORDA_EXTERNA=false
